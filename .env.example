# --- Database (Neon PostgreSQL) ---
# Create a free project at https://neon.tech, enable the pgvector extension
# (pnpm db:enable-extensions), then paste the pooled connection string here.
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/friday?sslmode=require"

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY="sk-ant-..."
# Optional overrides for the model router (defaults shown):
# MODEL_LOW="claude-haiku-4-5-20251001"
# MODEL_STANDARD="claude-sonnet-5"
# MODEL_HIGH="claude-opus-5"

# --- Auth (Auth.js v5 + Google OAuth) ---
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# FRIDAY is single-user. Only this email is allowed to sign in.
ALLOWED_EMAIL="you@example.com"
