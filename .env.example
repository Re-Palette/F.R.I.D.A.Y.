# --- Database (Neon PostgreSQL) ---
# Create a free project at https://neon.tech, enable the pgvector extension
# (pnpm db:enable-extensions), then paste the pooled connection string here.
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/friday?sslmode=require"

# --- LLM (Anthropic Claude) ---
# This is the only key the Research Agent needs too — it uses Anthropic's
# server-side web_search/web_fetch tools, billed as part of normal API
# usage (see https://platform.claude.com/docs/en/about-claude/pricing).
# Claude Code (this dev tool) is separate from this key — the deployed app
# has its own Anthropic API key and makes its own API calls at runtime.
ANTHROPIC_API_KEY="sk-ant-..."
# Model router overrides (defaults shown below). "Cheap by default, powerful
# when necessary": fast/default both default to Haiku (cheapest current
# tier); only powerful defaults to a higher-intelligence model. Individual
# Agent tools (Planning/Creation) pick fast vs. powerful per call based on
# their own complexity/importance judgment — see create-plan.ts/
# create-document.ts — so raising POWERFUL_MODEL doesn't make everything
# expensive, only the calls that actually opt into it.
# ANTHROPIC_FAST_MODEL="claude-haiku-4-5"        # chit-chat, classification, light summaries, research synthesis
# ANTHROPIC_DEFAULT_MODEL="claude-haiku-4-5"     # normal planning/creation work
# ANTHROPIC_POWERFUL_MODEL="claude-opus-5"       # complex planning, important documents, final review
# Set to "fast" during development to force every call onto the cheapest
# model regardless of task, with no code change.
# FORCE_MODEL_TIER="fast"

# --- Identity (NOT authentication) ---
# This deployment has no login step — anyone who can reach its URL can use
# it as this user (an explicit choice; see the removed Google OAuth flow in
# git history if you want it back). ALLOWED_EMAIL only labels the single
# owner row created in the `users` table; it enforces nothing.
ALLOWED_EMAIL="you@example.com"

# --- Access passcode (optional) ---
# Unset (the default) means no gate at all: anyone with the URL can use the
# app and spend your ANTHROPIC_API_KEY. Set it and every page and API route
# requires the passcode once per browser, stored in a long-lived HttpOnly
# cookie — so an installed PWA or a tab left open is never interrupted by a
# login screen. Changing the value invalidates every device at once, which
# is the only "sign out everywhere" there is.
# Failed attempts are rate limited in the database (10 per 15 minutes,
# counted globally), which is what makes a passcode you can actually
# remember safe here — a few hundred guesses a day defeats a wordlist. Still
# avoid anything derivable from you: a name, a birthday, an address you use.
# Several unrelated words strung together is both memorable and strong.
# APP_PASSCODE="..."

# --- Notion (optional — Creation Agent output destination) ---
# 1. Go to https://www.notion.so/my-integrations, create a new "Internal"
#    integration, copy its "Internal Integration Secret".
# 2. In Notion, open the page you want new documents created under, click
#    "..." -> "Connections" -> "Connect to" -> select your integration.
# 3. Copy that page's ID from its URL — the 32-char hex string right before
#    any "?" (dashes optional): notion.so/My-Page-<PAGE_ID>?v=...
# Without these two set, create_document's destination="notion" option
# silently falls back to saving locally instead.
# NOTION_API_KEY="ntn_..."
# NOTION_PARENT_PAGE_ID="..."

# --- Google Calendar (optional — read-only) ---
# FRIDAY has no login screen, so this is NOT an in-app OAuth flow — you
# mint a refresh token once, locally, and it's stored as a plain env var.
# 1. In Google Cloud Console, reuse or create an OAuth 2.0 Client (Web
#    application), enable the Calendar API for that project, and add
#    http://localhost:53682/callback as an authorized redirect URI.
# 2. Set GOOGLE_CALENDAR_CLIENT_ID/GOOGLE_CALENDAR_CLIENT_SECRET below.
# 3. Run `pnpm calendar:get-token`, approve access in the browser tab it
#    opens, and paste the printed GOOGLE_CALENDAR_REFRESH_TOKEN here too.
# Without all three set, calendar lookups just say they're not connected.
# GOOGLE_CALENDAR_CLIENT_ID="....apps.googleusercontent.com"
# GOOGLE_CALENDAR_CLIENT_SECRET="..."
# GOOGLE_CALENDAR_REFRESH_TOKEN="..."
# To read a second Google account (a personal calendar alongside a work
# one), repeat step 3 signed in as that account and add its token as _2;
# number any further accounts _3, _4, ... The client ID/secret stay shared —
# only the account that authorized each token differs. Every visible
# calendar of every account is read, and anything outside the first
# account's own calendar is labelled with the calendar it came from.
# GOOGLE_CALENDAR_REFRESH_TOKEN_2="..."

# --- Gmail (optional — read + send) ---
# Needs its own refresh token: a token's scopes are fixed when it is minted,
# and the calendar ones were granted calendar.readonly only. Mint this one
# the same way, signed in as the account mail should come FROM, with scopes
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/gmail.compose
#   https://www.googleapis.com/auth/gmail.send
# and enable the Gmail API for the project in Google Cloud Console.
# gmail.compose is what allows writing drafts — readonly+send alone returns
# 403 insufficient scopes on drafts.create (verified, not assumed).
# Reading and drafting are automatic; sending waits for approval at
# /approvals.
# One account only — which mailbox mail leaves from should be unambiguous.
# GOOGLE_GMAIL_REFRESH_TOKEN="..."
# The OAuth client is shared by every Google integration. These names are
# preferred; the GOOGLE_CALENDAR_* pair above still works as a fallback.
# GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="..."

# --- Google Drive (optional — read-only) ---
# Again its own refresh token, minted the same way with scope
#   https://www.googleapis.com/auth/drive.readonly
# and the Drive API enabled for the project. Google Docs/Sheets/Slides are
# exported as text; binary formats report that they can't be read.
# GOOGLE_DRIVE_REFRESH_TOKEN="..."

# --- GitHub (optional — read-only) ---
# No OAuth flow: a fine-grained personal access token from
# https://github.com/settings/tokens?type=beta is enough. Grant read-only
# repository access (Contents, Issues, Metadata) — nothing here writes, so
# nothing more is needed. Classic tokens work too, with the `repo` scope.
# GITHUB_TOKEN="github_pat_..."

# --- Voice (optional — ElevenLabs) ---
# The home screen is a spoken interface, and without this it speaks with
# whatever synthetic voice the browser ships: serviceable, and obviously a
# machine reading text. ElevenLabs replaces it with a voice you pick or
# design, and the app falls back to the browser one whenever this is unset,
# fails, or runs out of quota — so setting it is an upgrade, never a
# dependency.
# 1. Create a key at https://elevenlabs.io/app/settings/api-keys.
# 2. Pick or design a voice at https://elevenlabs.io/app/voice-lab — Voice
#    Design writes one from a description ("落ち着いた日本語の女性の声、低め、
#    少しかすれた、淡々と") — then copy its Voice ID from the voice's menu.
# 3. Check the voice actually speaks Japanese well before settling on it;
#    many library voices are English-only in practice.
# Billing is per character, which is why replies are capped at 1200
# characters of speech (the subtitle always shows the whole thing) and why
# /api/speech sits behind APP_PASSCODE like everything else.
# ELEVENLABS_API_KEY="sk_..."
# ELEVENLABS_VOICE_ID="..."
# Flash is the low-latency model and the default. eleven_multilingual_v2 is
# more expressive and noticeably slower; eleven_v3 is the most expressive of
# all. In a spoken conversation the wait is usually worth more than the
# nuance, so change this only if a voice you like needs it.
# ELEVENLABS_MODEL_ID="eleven_flash_v2_5"
# Readings for words no engine gets right — names, places, your own company.
# `書き方=よみかた`, separated by commas; kana on the right, since kana can't
# be misread. Applies to the ElevenLabs voice and the browser's alike. The
# app's own name is built in, so only add what is yours. NEXT_PUBLIC_ because
# the text is prepared in the browser; it is pronunciation, not a secret.
# NEXT_PUBLIC_SPEECH_READINGS="Re-Palette=リパレット,日下部=くさかべ"

# --- Weather (no key needed) ---
# The top-right panel reads Open-Meteo, which is free and needs no account,
# so there is nothing to set for Tokyo — these only move it somewhere else.
# WEATHER_PLACE is the label in the panel header; the coordinates and
# timezone are what is actually asked for.
# WEATHER_PLACE="TOKYO"
# WEATHER_LATITUDE="35.6785"
# WEATHER_LONGITUDE="139.6823"
# WEATHER_TIMEZONE="Asia/Tokyo"

# --- Scheduled work (optional) ---
# vercel.json schedules one job: /api/cron at 22:00 UTC (07:00 JST), which
# writes the daily brief and runs whatever scheduled tasks have come due.
# One daily entry because plans cap how many crons a project may have and
# how often they may run — and it costs nothing, since the dispatcher runs
# everything *overdue* rather than only what is due at that moment, so a
# coarser cadence, or a firing that is missed, delays work instead of
# dropping it. On a plan allowing frequent crons, add a second entry
# pointing at /api/cron/tasks to make scheduled tasks more responsive.
# Vercel signs scheduled invocations with this secret; without it both
# endpoints refuse every request rather than running for anyone who finds
# the path. The passcode gate can't protect them — a scheduled request
# carries no cookie — so this is the only thing standing in front of them.
# Generate a long random value; Vercel offers to create one for you.
# Results land as new conversations, waiting when you open the app.
# CRON_SECRET="..."
# Fixed UTC offset used for "today"/"tomorrow" day boundaries — Japan has
# no DST, so a plain offset is enough (default shown).
# CALENDAR_TIMEZONE_OFFSET="+09:00"
