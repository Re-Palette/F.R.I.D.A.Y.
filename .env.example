# --- Database (Neon PostgreSQL) ---
# Create a free project at https://neon.tech, enable the pgvector extension
# (pnpm db:enable-extensions), then paste the pooled connection string here.
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/friday?sslmode=require"

# --- LLM (OpenAI) ---
# This is the only key the Research Agent needs too — it uses OpenAI's
# server-side web_search tool, billed as part of normal API usage.
OPENAI_API_KEY="sk-..."
# Model router overrides (defaults shown below). IMPORTANT: these defaults
# were read out of the installed `openai` SDK's own type definitions, not
# OpenAI's docs — this sandbox's network policy blocks platform.openai.com,
# so they could not be verified live. Confirm current model IDs and pricing
# at https://platform.openai.com/docs/models before relying on this in
# production, and update these three vars (no code change needed) if so.
# OPENAI_FAST_MODEL="gpt-5.6-luna"        # low cost: chit-chat, classification, light summaries
# OPENAI_CHAT_MODEL="gpt-5.6-terra"       # standard: normal Agent turns, research synthesis
# OPENAI_REASONING_MODEL="gpt-5.6-sol"    # high intelligence: planning, multi-agent coordination, final review
# Set to "low" during development to force every call onto OPENAI_FAST_MODEL
# regardless of task, with no code change.
# FORCE_MODEL_TIER="low"

# --- Auth (Auth.js v5 + Google OAuth) ---
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# FRIDAY is single-user. Only this email is allowed to sign in.
ALLOWED_EMAIL="you@example.com"
